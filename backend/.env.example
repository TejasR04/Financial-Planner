ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian
# Keep the hosted pool deliberately small. Supabase's session pooler handles
# network compatibility while SQLAlchemy reuses a bounded set of connections.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=300

JWT_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=meridian_refresh
# Must be true in production (HTTPS).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REGISTRATION_ENABLED=false
# Vercel and Cloud Run use different sites. In production set this to none
# together with REFRESH_COOKIE_SECURE=true so refresh cookies cross domains.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000
# In development, omit SMTP_HOST and the reset link will be written to API logs.
# In production, configure an SMTP sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Local/always-on polling only; not a wall-clock schedule. A database lease
# prevents concurrent runners. For production 8 AM / 8 PM sync, keep this false
# and deploy the separate Cloud Run job (see DEPLOYMENT.md).
PLAID_AUTO_SYNC_ENABLED=true
PLAID_AUTO_SYNC_INTERVAL_MINUTES=1440
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in every environment that stores linked Plaid accounts. Rotating
# this key makes existing stored access tokens undecryptable, so back it up
# somewhere safe (a secrets manager, not source control) once you're past sandbox.
PLAID_TOKEN_ENCRYPTION_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
